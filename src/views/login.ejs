<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechPoint | Administración</title>
    <link rel="icon" type="image/png" href="/cliente/img/favicon.png">
    <link rel="stylesheet" href="/admin/css/login.css">
</head>

<body>

    <header>
        <div class="marca">
            <img src="/cliente/img/logo.png" alt="Logo de TechPoint" class="logo">

            <p class="integrantes">
                Integrantes: Julián Mas y Federico Ameratte
            </p>
        </div>

        <button id="btnTema" class="btn-tema" type="button">
            🌙 Tema oscuro
        </button>
    </header>

    <main>
        <section class="login">
            <h2>Acceso de administrador</h2>

            <p>Ingresá tus credenciales para continuar.</p>

            <form id="formLogin">

                <label for="email">Correo electrónico:</label>
                <input
                    type="email"
                    id="email"
                    placeholder="Ingresá tu correo"
                    required
                >

                <label for="password">Contraseña:</label>
                <input
                    type="password"
                    id="password"
                    placeholder="Ingresá tu contraseña"
                    required
                >

                <button type="submit">Iniciar sesión</button>

                <button type="button" id="btnAccesoRapido">
                    Acceso rápido para docentes
                </button>

                <p id="mensaje"></p>

            </form>

            <a href="/cliente/index.html" class="volver">
                Volver a la tienda
            </a>
        </section>
    </main>

    <script src="/cliente/js/tema.js"></script>
    <script src="/admin/js/login.js"></script>

</body>
</html>